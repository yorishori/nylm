#!/bin/sh
# Starts the music library scan (nylm-music-scan.service, which runs
# `nylm music-scan` as user nylm) and returns at once. Takes no arguments.
set -eu
if [ "$#" -ne 0 ]; then
    echo "music-scan: takes no arguments" >&2
    exit 2
fi
exec /usr/bin/systemctl start --no-block nylm-music-scan.service
