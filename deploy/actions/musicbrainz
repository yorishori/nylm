#!/bin/sh
# Starts one job of the MusicBrainz service (nylm-musicbrainz@JOB.service,
# which runs nylm-musicbrainz JOB as user nylm) and returns at once.
# Argument: ids (find album ids) or genres (find genres).
set -eu
if [ "$#" -ne 1 ]; then
    echo "musicbrainz: takes one argument: ids or genres" >&2
    exit 2
fi
case $1 in
    ids|genres) ;;
    *) echo "musicbrainz: not ids or genres: $1" >&2; exit 2 ;;
esac
exec /usr/bin/systemctl start --no-block "nylm-musicbrainz@$1.service"
