[Unit]
Description=nylm music library scan
Documentation=file:///usr/local/share/nylm/README.md

# Started from the web app (action music-scan) or by hand:
#   sudo systemctl start nylm-music-scan
# Only one runs at a time; it reads new and changed files and writes no file.
[Service]
Type=oneshot
User=nylm
Group=nylm
EnvironmentFile=/etc/nylm.conf
ExecStart=/usr/local/bin/nylm music-scan
WorkingDirectory=/var/lib/nylm
# Background work: everything else goes first.
Nice=10
IOSchedulingClass=idle
