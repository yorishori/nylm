[Unit]
Description=nylm genres from MusicBrainz
Documentation=file:///usr/local/share/nylm/README.md
Wants=network-online.target
After=network-online.target

# Started from the web app (action musicbrainz) or by hand:
#   sudo systemctl start nylm-musicbrainz
# Looks up on musicbrainz.org the genres of the next 10 albums without one
# (by their MusicBrainz album id) and queues them as changes; it never
# touches the music files. Links libssl, like nylm-qobuz; the server
# does not.
[Service]
Type=oneshot
User=nylm
Group=nylm
EnvironmentFile=/etc/nylm.conf
ExecStart=/usr/local/bin/nylm-musicbrainz
WorkingDirectory=/var/lib/nylm
Nice=10
